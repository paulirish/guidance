+  <!-- Logout Confirmation Modal -->
+  <div id="logout-modal" class="modal-overlay">
+    <div class="modal">
+      <h2>Logout?</h2>
+      <p>Are you sure you want to log out of your account?</p>
+      <div class="modal-buttons">
+        <button id="cancel-logout" class="btn btn-cancel">Cancel</button>
+        <button id="confirm-logout" class="btn btn-confirm">Logout</button>
+      </div>
+    </div>
+  </div>
+
+  <script>
+    // Polyfill for Promise.withResolvers() if not supported by the environment
+    if (typeof Promise.withResolvers !== 'function') {
+      Promise.withResolvers = function () {
+        let resolve, reject;
+        const promise = new Promise((res, rej) => {
+          resolve = res;
+          reject = rej;
+        });
+        return { promise, resolve, reject };
+      };
+    }
+
+    const logoutLink = document.querySelector('.logout-link');
+    const logoutModal = document.getElementById('logout-modal');
+    const confirmBtn = document.getElementById('confirm-logout');
+    const cancelBtn = document.getElementById('cancel-logout');
+
+    /**
+     * Waits for user interaction on the logout modal.
+     * Uses Promise.withResolvers() to manage the asynchronous external signal.
+     */
+    function waitForLogoutSignal() {
+      const { promise, resolve, reject } = Promise.withResolvers();
+
+      try {
+        // Show the UI
+        logoutModal.classList.add('visible');
+
+        // Handle success
+        const onConfirm = () => {
+          cleanup();
+          resolve({ confirmed: true });
+        };
+
+        // Handle cancellation
+        const onCancel = () => {
+          cleanup();
+          // Reject with an Error object to maintain useful stack traces
+          reject(new Error('User cancelled logout interaction'));
+        };
+
+        function cleanup() {
+          logoutModal.classList.remove('visible');
+          // Explicitly remove listeners to prevent memory leaks
+          confirmBtn.removeEventListener('click', onConfirm);
+          cancelBtn.removeEventListener('click', onCancel);
+        }
+
+        // Attach listeners to trigger the resolution/rejection
+        confirmBtn.addEventListener('click', onConfirm, { once: true });
+        cancelBtn.addEventListener('click', onCancel, { once: true });
+      } catch (err) {
+        // Manually route synchronous setup errors to the promise rejection
+        reject(err);
+      }
+
+      return promise;
+    }
+
+    // Intercept logout link click
+    if (logoutLink) {
+      logoutLink.addEventListener('click', async (event) => {
+        event.preventDefault();
+
+        try {
+          // Execution pauses here until the user interacts with the modal
+          await waitForLogoutSignal();
+          console.log('Logout confirmed');
+          window.location.href = logoutLink.href;
+        } catch (error) {
+          // Handles the rejection from the cancel button or setup errors
+          console.warn('Logout aborted:', error.message);
+        }
+      });
+    }
+  </script>
