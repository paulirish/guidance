+  <script>
+    /**
+     * Polyfill for Promise.withResolvers if not supported by the environment.
+     * This follows the pattern recommended in the guide.
+     */
+    if (typeof Promise.withResolvers !== 'function') {
+      Promise.withResolvers = function() {
+        let resolve, reject;
+        const promise = new Promise((res, rej) => {
+          resolve = res;
+          reject = rej;
+        });
+        return { promise, resolve, reject };
+      };
+    }
+
+    class CoffeeShop {
+      #pendingTasks = new Map();
+      #orderCount = 0;
+
+      constructor() {
+        this.pendingList = document.getElementById('pending-list');
+        this.baristaList = document.getElementById('barista-list');
+        this.logElement = document.getElementById('log');
+      }
+
+      log(message) {
+        const time = new Date().toLocaleTimeString();
+        this.logElement.innerHTML += `<div>[${time}] ${message}</div>`;
+        this.logElement.scrollTop = this.logElement.scrollHeight;
+      }
+
+      /**
+       * Place an order using Promise.withResolvers()
+       */
+      order(drinkName) {
+        const { promise, resolve, reject } = Promise.withResolvers();
+        const orderId = ++this.#orderCount;
+
+        try {
+          if (this.#pendingTasks.size >= 5) {
+            throw new Error("Barista is overwhelmed! Try again later.");
+          }
+
+          this.log(`Placing order #${orderId}: ${drinkName}`);
+          
+          // Store resolvers in the registry
+          this.#pendingTasks.set(orderId, { drinkName, resolve, reject });
+
+          this.render();
+
+          // Handle the promise fulfillment
+          promise
+            .then(result => {
+              this.log(`SUCCESS: Order #${result.orderId} (${result.drinkName}) is ready!`);
+            })
+            .catch(error => {
+              this.log(`FAILED: Order #${orderId} was cancelled. Reason: ${error.message}`);
+            });
+
+        } catch (err) {
+          // Handle synchronous errors manually as per guidance
+          this.log(`ERROR: ${err.message}`);
+          reject(err);
+        }
+
+        return promise;
+      }
+
+      /**
+       * Settle a task from an external context (Barista Console)
+       */
+      settleOrder(orderId, success) {
+        const task = this.#pendingTasks.get(orderId);
+        if (!task) return;
+
+        if (success) {
+          task.resolve({ orderId, drinkName: task.drinkName, status: 'served' });
+        } else {
+          task.reject(new Error("Machine malfunction or out of beans."));
+        }
+
+        // Clean up registry to prevent memory leaks
+        this.#pendingTasks.delete(orderId);
+        this.render();
+      }
+
+      render() {
+        // Render Pending Orders (Customer View)
+        if (this.#pendingTasks.size === 0) {
+          this.pendingList.innerHTML = '<p style="color: #666; text-align: center; margin-top: 20px;">No active orders.</p>';
+          this.baristaList.innerHTML = '<p style="color: #666; text-align: center; margin-top: 20px;">Waiting for orders...</p>';
+          return;
+        }
+
+        let pendingHtml = '';
+        let baristaHtml = '';
+
+        this.#pendingTasks.forEach((task, id) => {
+          pendingHtml += `
+            <div class="order-item">
+              <span><strong>#${id}</strong> ${task.drinkName}</span>
+              <span class="status-badge status-pending">Preparing...</span>
+            </div>
+          `;
+
+          baristaHtml += `
+            <div class="order-item">
+              <span><strong>#${id}</strong> ${task.drinkName}</span>
+              <div class="barista-controls">
+                <button class="btn-small btn-complete" onclick="shop.settleOrder(${id}, true)">Serve</button>
+                <button class="btn-small btn-reject" onclick="shop.settleOrder(${id}, false)">Cancel</button>
+              </div>
+            </div>
+          `;
+        });
+
+        this.pendingList.innerHTML = pendingHtml;
+        this.baristaList.innerHTML = baristaHtml;
+      }
+    }
+
+    const shop = new CoffeeShop();
+  </script>
+
 </body>
 
