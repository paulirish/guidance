index 0000000..a3121c5
--- /dev/null
+++ b/stream-utils.js
@@ -0,0 +1,121 @@
+/**
+ * Feature detection and conditional polyfill for Promise.withResolvers.
+ * Promise.withResolvers() provides external control over a promise's lifecycle.
+ */
+if (!Promise.withResolvers) {
+  Promise.withResolvers = function() {
+    let resolve, reject;
+    const promise = new Promise((res, rej) => {
+      resolve = res;
+      reject = rej;
+    });
+    return { promise, resolve, reject };
+  };
+}
+
+/**
+ * Converts an event-based stream into an AsyncIterable.
+ * This implementation queues events to ensure no data is lost if multiple
+ * events occur before the async iterable's next() call is resolved.
+ *
+ * @param {Object} eventSource - The source emitting 'data', 'end', and 'error' events.
+ * @returns {AsyncIterable} An async iterable that yields data from the stream.
+ */
+export function streamToAsyncIterable(eventSource) {
+  const dataQueue = [];
+  const resolverQueue = [];
+  let isDone = false;
+  let error = null;
+
+  // Event handlers
+  const onData = (data) => {
+    if (resolverQueue.length > 0) {
+      const { resolve } = resolverQueue.shift();
+      resolve({ value: data, done: false });
+    } else {
+      dataQueue.push(data);
+    }
+  };
+
+  const onEnd = () => {
+    isDone = true;
+    while (resolverQueue.length > 0) {
+      const { resolve } = resolverQueue.shift();
+      resolve({ value: undefined, done: true });
+    }
+    cleanup();
+  };
+
+  const onError = (err) => {
+    error = err;
+    while (resolverQueue.length > 0) {
+      const { reject } = resolverQueue.shift();
+      reject(err);
+    }
+    cleanup();
+  };
+
+  // Helper to remove event listeners
+  const cleanup = () => {
+    const off = eventSource.off || eventSource.removeListener;
+    if (typeof off === 'function') {
+      off.call(eventSource, 'data', onData);
+      off.call(eventSource, 'end', onEnd);
+      off.call(eventSource, 'error', onError);
+    }
+  };
+
+  // Attach event listeners
+  if (typeof eventSource.on === 'function') {
+    eventSource.on('data', onData);
+    eventSource.on('end', onEnd);
+    eventSource.on('error', onError);
+  }
+
+  return {
+    [Symbol.asyncIterator]() {
+      return this;
+    },
+    /**
+     * Returns the next chunk of data from the stream.
+     * @returns {Promise<IteratorResult>}
+     */
+    async next() {
+      // 1. If there's data in the queue, return it immediately.
+      if (dataQueue.length > 0) {
+        return { value: dataQueue.shift(), done: false };
+      }
+      
+      // 2. If an error occurred, re-throw it.
+      if (error) {
+        throw error;
+      }
+      
+      // 3. If the stream has ended, return the terminal state.
+      if (isDone) {
+        return { value: undefined, done: true };
+      }
+
+      // 4. Otherwise, wait for the next event using Promise.withResolvers().
+      const { promise, resolve, reject } = Promise.withResolvers();
+      resolverQueue.push({ resolve, reject });
+      return promise;
+    },
+    /**
+     * Gracefully closes the iterator and cleans up listeners.
+     */
+    async return() {
+      isDone = true;
+      cleanup();
+      return { value: undefined, done: true };
+    },
+    /**
+     * Handles errors thrown during iteration.
+     */
+    async throw(err) {
+      isDone = true;
+      cleanup();
+      throw err;
+    }
+  };
+}
