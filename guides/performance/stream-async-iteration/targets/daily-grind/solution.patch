+      if (isHeader) {
+        entry.style.color = 'var(--accent)';
+        entry.style.fontWeight = 'bold';
+        entry.style.borderBottom = '1px solid #4e342e';
+        entry.style.paddingBottom = '5px';
+      }
+      entry.textContent = `[${new Date().toLocaleTimeString()}] ${message}`;
+      logElement.appendChild(entry);
+      logElement.scrollTop = logElement.scrollHeight;
+    }
+
+    async function processOrderStream(stream) {
+      // MANDATORY: Use the bridge to get an async iterable
+      const iterable = streamToAsyncIterable(stream);
+
+      try {
+        // Sequential processing: handles backpressure naturally
+        for await (const status of iterable) {
+          appendLog(status);
+          // Simulate complex processing work (e.g., database update or UI animation)
+          await new Promise(resolve => setTimeout(resolve, 800));
+        }
+        appendLog('--- Order Complete ---', true);
+      } catch (error) {
+        appendLog(`ERROR: ${error.message}`);
+      }
+    }
+
+    startBtn.addEventListener('click', () => {
+      startBtn.disabled = true;
+      logElement.innerHTML = '';
+      appendLog('--- Starting New Order Simulation ---', true);
+
+      const stream = new EventEmitter();
+      
+      // Start processing BEFORE emitting data to demonstrate the bridge
+      processOrderStream(stream).finally(() => {
+        startBtn.disabled = false;
+      });
+
+      // Simulate a "push" stream emitting data rapidly
+      // The bridge's queue ensures no data is lost even though processing is slow
+      const events = [
+        'Grinding Ethiopian Yirgacheffe beans...',
+        'Warming the portafilter...',
+        'Tamping at 30lbs of pressure...',
