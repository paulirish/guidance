+        'Crafting a perfect rosette...',
+        'Sprinkling a touch of cinnamon...'
+      ];
+
+      events.forEach((msg, i) => {
+        setTimeout(() => stream.emit('data', msg), i * 100);
+      });
+
+      setTimeout(() => stream.emit('end'), events.length * 100 + 500);
+    });
